# ── ฐานข้อมูล ─────────────────────────────────────────────
# Production: connection string ของ Postgres บนคลาวด์ (Neon / Supabase / Railway / RDS)
# Local dev:  รัน `npx prisma dev` แล้ววาง URL ที่ได้ตรงนี้
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ── ความปลอดภัย ───────────────────────────────────────────
# สุ่มใหม่ก่อนขึ้น production:  node -e "console.log(require(\"crypto\").randomBytes(48).toString(\"base64url\"))"
AUTH_SECRET="<สุ่มค่าใหม่ก่อน deploy>"

# ── ค่าเริ่มต้นบัญชีผู้ดูแล (ใช้ตอน seed เท่านั้น) ─────────────
SEED_SUPERADMIN_USERNAME="superadmin"
SEED_SUPERADMIN_PASSWORD="<ตั้งรหัสผ่านแรกเข้า>"

# ── ตัวเลือกหน้าเว็บ ───────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="AOT Badminton 2569"
